# Copy to .env and fill in what you have. Nothing here is required —
# the platform runs on local models and files with all of it blank.
#
# Startup prints which of these are wired, so a missing key shows up then
# rather than as a confusing failure mid-conversation.

# -------------------------------------------------------------------- topology
# edge   the machine driving a panel: conversation, models, footage, kiosk UI
# cloud  the platform: avatars, kiosks, studio. No models, no GPU, no footage.
# all    both in one process — development, and a single-kiosk install
LUXORA_ROLE=all

# Edge only. Where to pull avatar config from. Blank = standalone, reading only
# what is on this machine's disk. Sync writes into the same folders the app
# already reads, so a kiosk that loses the network keeps serving its last state.
PLATFORM_URL=
SYNC_INTERVAL=300

# Which cabinet this machine is. The backend answers with the avatar assigned
# to it, so re-pointing a screen needs no rebuild. Sync uses the same id to pull
# this cabinet's configuration and no other tenant's, so keep the two in step.
VITE_KIOSK_ID=default
KIOSK_ID=default

# --------------------------------------------------------------------- accounts
# Signs the studio's session tokens. Generated on first use and written to
# knowledge/.secret if left blank — set it explicitly when several machines share
# a platform, so a token issued by one is accepted by the others.
#
# With no accounts on a machine the studio is open, which is the single-kiosk
# install. Creating the first account closes it permanently.
LUXORA_SECRET=

# Comma-separated origins allowed to call this API from a browser. Blank adds no
# CORS middleware at all, which is correct when the kiosk is served from this
# same origin — which it is, in every shape this project ships. Set it only for
# a frontend hosted somewhere else, and list exact origins: a wildcard plus
# credentials hands a studio session to whichever page asks for it.
ALLOWED_ORIGINS=

# ---------------------------------------------------------------- conversation
# Local by default. A kiosk that goes mute when the Wi-Fi drops is a worse
# failure than a slow one, so these keep working with nothing configured.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
WHISPER_MODEL=base.en

# Hosted alternatives. Each one swaps a single module.
ANTHROPIC_API_KEY=
GROQ_API_KEY=            # fast + cheap: intent, routing, pronoun resolution
DEEPGRAM_API_KEY=        # streaming STT, ~300ms
CARTESIA_API_KEY=        # streaming TTS, ~90ms to first byte
ELEVENLABS_API_KEY=      # more expressive TTS, slower

# --------------------------------------------------------------------- avatar
# mp4 = crossfaded clips, free and offline, no lip-sync.
AVATAR_PROVIDER=mp4
SIMLI_API_KEY=           # ~$0.009/min
HEYGEN_API_KEY=          # ~$0.10/min, photo-to-avatar confirmed
ANAM_API_KEY=            # ~$0.18/min, ~180ms

LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ------------------------------------------------------------------- platform
# Blank = avatars and kiosks are read from disk. Set these and the same
# interface is served from Postgres instead.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------ knowledge
FIRECRAWL_API_KEY=       # website -> clean markdown
VOYAGE_API_KEY=          # embeddings
OPENAI_API_KEY=          # embeddings

# NVIDIA NIM — free, no card, OpenAI-compatible, 40 req/min.
# 11 embedding models and 123 chat models. Good for Segment 2 embeddings and for
# A/B-ing a large model against the local one. Keep it out of the conversation
# path: a free tier has no SLA.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# ----------------------------------------------------------------- generation
FAL_KEY=                 # virtual try-on, avatar clip generation
REPLICATE_API_TOKEN=

# --------------------------------------------------------------------- try-on
# local | replicate | fal. Local is preferred and not yet wired: a garment swap
# on an M4 Pro takes 10-30s, which is fine for a photo-in-photo-out feature, and
# the visitor's photograph then never leaves the cabinet. That is a legal
# argument as much as a cost one — see the header of backend/tryon.py.
#
# Whichever is used: the photo is held in memory, never written to disk, and
# never reaches the event log.
TRYON_PROVIDER=local
TRYON_MODEL_REPLICATE=c871bb9b046607b680449ecbae55fd8c6d945e0a1948644bf2361b3d021d3ff4
TRYON_MODEL_FAL=fal-ai/idm-vton

# ----------------------------------------------------------------- operations
# Skipping these is the thing people regret. Debugging why a digital human said
# the wrong thing without prompt and retrieval traces is miserable.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
SENTRY_DSN=
